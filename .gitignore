# ---- 本地运行时产物（不入库）----
# 注意：git 的 .gitignore 不支持行尾注释，规则必须独占一行

# 模型/参数设置（可能含各 provider 的 API Key 明文，仅本地）
cpq_settings.json
xbom_settings.json
rule_settings.json

# 各助手的本地历史会话（每个会话一个 JSON）
cpq_history/
xbom_history/
rule_history/

# quote_bom.db 的时间戳备份
*.db.bak_*

# Python / Office 临时产物
__pycache__/
*.pyc
~$*.xlsx

# open-claude 引擎已并入本仓库（2026-07-16 起），只含编译后的 .pyc（源码保护）
# .pyc 需要入库，豁免上面的 *.pyc 规则；.venv 仍不入库
!open-claude/**/*.pyc
open-claude/.venv/

# SQLite WAL/共享内存临时文件（运行时产物）
*.sqlite-shm
*.sqlite-wal

# Claude Code 本地会话产物（权限白名单等，仅本机）
.claude/settings.local.json
.agents/
