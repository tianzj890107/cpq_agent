# ---- 本地运行时产物（不入库）----
# 注意：git 的 .gitignore 不支持行尾注释，规则必须独占一行

# 模型/参数设置（可能含各 provider 的 API Key 明文，仅本地）
cpq_settings.json
xbom_settings.json
rule_settings.json

# .env（含 API Key 明文，绝不入库）——技术工艺模型改由「设置」提供，不再依赖 .env
.env
tech_app/.env
tech_app/tech_data/
tech_app/data/

# 各助手的本地历史会话（每个会话一个 JSON）
cpq_history/
xbom_history/
rule_history/

# 历史遗留 .db 备份（登录/工作流数据已全部改存线上 Postgres，本地不再有 sqlite）
*.db.bak_*

# Python / Office 临时产物
__pycache__/
*.pyc
~$*.xlsx
.DS_Store

# open-claude 引擎已并入本仓库（2026-07-16 起），只含编译后的 .pyc（源码保护）
# .pyc 需要入库，豁免上面的 *.pyc 规则；.venv 仍不入库
!open-claude/**/*.pyc
open-claude/.venv/

# SQLite WAL/共享内存临时文件（运行时产物）
*.sqlite-shm
*.sqlite-wal

# Claude Code 本地会话产物（权限白名单等，仅本机）
.claude/settings.local.json
.agents/
