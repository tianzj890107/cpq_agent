          "steps.open.result.meta.participants": {
            "$absent": true
          },
          "steps.open_plain.status": 404,
          "steps.outsider.status": 404
        },
        "records": {
          "http_calls": 3
        },
        "forbidden": [
          "acl_forbidden_message_leaked",
          "http_error_without_trace",
          "cross_project_leak",
          "production_host_called",
          "real_secret_used"
        ]
      },
      "invariants": [
        "single_source_of_truth"
      ],
      "tags": [
        "negative",
        "permission",
        "normal"
      ],
      "source_specs": [
        "docs/specs/tech-project-acl-visible-scope.md",
