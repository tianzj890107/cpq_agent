{
  "suite_id": "auth_acl.production_finance_read",
  "title": "财务经理读取回归（真实 HTTP 路由 + 真实 project_access）",
  "domain": "auth_acl",
  "notes": "全部用例走真实生产代码边界：production_http 经真实 FastAPI app/TestClient 与真鉴权依赖；production_unit 直接调用 backend.services.project_access。",
