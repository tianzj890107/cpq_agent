      },
      "roles": [
        "finance_mgr",
        "viewer"
      ],
      "preconditions": {},
      "input": {
        "access_matrix": {
          "dave": "allow",
          "heidi": "deny"
        },
        "identities": {
          "finance": {
            "username": "dave",
            "display_name": "戴夫",
            "sso_roles": [
              "finance_manager"
            ],
            "cpq_role_code": "finance_mgr",
            "tech_role": "finance_manager"
          },
          "outsider": {
            "username": "heidi",
            "display_name": "海蒂",
            "sso_roles": [
              "viewer"
            ],
            "cpq_role_code": "viewer",
            "tech_role": "viewer"
          }
        },
        "projects": {
          "handoff": {
            "owner": "carol",
            "filename": "finance-handoff.dxf",
            "plan": {
              "finance_handoff": {
                "sent_at": "2026-09-17T10:00:00+08:00",
                "sent_by": "carol",
                "task_id": "T-COST-1",
                "task_no": "RW-1",
                "target_role_name": "财务经理",
                "target_type": "role"
              }
            },
            "participants": []
          },
          "plain": {
            "owner": "carol",
            "filename": "no-handoff.dxf",
            "participants": []
          }
        },
        "steps": [
          {
            "id": "open",
            "http": {
              "identity": "finance",
              "method": "GET",
              "path": "/api/projects/{project_id}",
              "project": "handoff"
