        "projects": {},
        "identities": {
          "unknown": {
            "username": "mallory",
            "sso_roles": [],
            "cpq_role_code": "super_admin"
          }
        },
        "steps": [
          {
            "id": "unknown",
            "call": {
              "args": {
                "cpq_user": {
                  "username": "mallory",
                  "role_code": "super_admin"
                }
              }
            }
          },
          {
            "id": "empty",
            "call": {
              "args": {
                "cpq_user": {
                  "username": "mallory",
                  "role_code": ""
                }
              }
            }
          },
          {
            "id": "case",
            "call": {
              "args": {
                "cpq_user": {
                  "username": "mallory",
                  "role_code": "FINANCE_MGR"
                }
              }
            }
          }
        ]
      },
      "actions": [],
      "expected": {
        "state": {
          "steps.unknown.result.role": "viewer",
          "steps.empty.result.role": "viewer",
          "steps.case.result.role": "viewer"
        },
        "records": {
          "unit_calls": 3
        },
        "forbidden": [
          "sim_fallback"
        ]
      },
      "invariants": [],
      "tags": [
