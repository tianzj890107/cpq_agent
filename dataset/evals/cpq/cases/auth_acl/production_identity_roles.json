    {
      "id": "acl.real.identity.empty_role_cannot_read",
      "version": "1.0",
      "title": "没有任何角色信息的用户读不到任何项目：空身份不得被当成管理员",
      "domain": "auth_acl",
      "priority": "P0",
      "layer": "deterministic",
      "executor": "production_unit",
      "entry": {
        "module": "backend.services.project_access",
        "function": "can_read"
      },
      "roles": [
        "viewer"
      ],
      "preconditions": {},
      "input": {
        "access_matrix": {
          "dave": "allow",
          "nobody": "deny"
        },
        "projects": {},
        "identities": {
          "nobody": {
            "username": "nobody",
            "sso_roles": [],
            "tech_role": "viewer"
          }
        },
        "steps": [
          {
            "id": "empty",
            "call": {
              "args": {
                "user": {
                  "username": "ghost"
                },
                "meta": {
                  "project_id": "aaaaaaaaaaaa",
                  "owner": "carol"
                }
              }
            }
          },
          {
            "id": "no_meta",
            "call": {
              "args": {
                "user": {
                  "$identity": "nobody"
                },
                "meta": {}
              }
            }
          }
        ]
      },
      "actions": [],
      "expected": {
        "state": {
          "steps.empty.result": false,
          "steps.no_meta.result": false
        },
        "records": {
          "unit_calls": 2
        },
        "forbidden": [
          "sim_fallback"
        ]
      },
      "invariants": [],
      "tags": [
        "negative",
        "permission"
      ],
      "source_specs": [
        "docs/specs/tech-project-identity-single-source.md",
        "docs/specs/tech-project-acl-visible-scope.md",
        "module:backend.services.project_access"
      ],
      "failure_type": "permission_denied"
    },
