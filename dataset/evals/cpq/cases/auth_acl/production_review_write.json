    {
      "id": "acl.real.finance_related_but_wrong_duty_gets_route_403",
      "version": "1.0",
      "title": "财务经理与项目相关但无审核职责：拿到的是接口专属 403，文案指向工艺技术总监，而不是通用写拒绝",
      "domain": "auth_acl",
      "priority": "P0",
      "layer": "deterministic",
      "executor": "production_http",
      "entry": {
        "http": {
          "method": "POST",
          "path": "/api/projects/{project_id}/process-report/publish"
        }
      },
      "roles": [
        "finance_mgr"
      ],
      "preconditions": {},
      "input": {
        "access_matrix": {
          "dave": "allow",
          "heidi": "deny"
        },
        "identities": {
          "finance": {
            "username": "dave",
            "display_name": "戴夫",
            "sso_roles": [
              "finance_manager"
            ],
            "cpq_role_code": "finance_mgr",
            "tech_role": "finance_manager"
          },
          "director": {
            "username": "frank",
            "display_name": "弗兰克",
            "sso_roles": [
              "process_director"
            ],
            "cpq_role_code": "tech_director",
            "tech_role": "process_director"
          }
        },
        "projects": {
          "handoff": {
            "owner": "carol",
            "filename": "handoff.dxf",
            "plan": {
              "finance_handoff": {
                "sent_at": "2026-09-17T10:00:00+08:00",
                "sent_by": "carol",
                "task_id": "T-COST-1",
                "task_no": "RW-1",
                "target_role_name": "财务经理",
                "target_type": "role"
              }
            },
            "participants": []
          }
        },
        "steps": [
          {
            "id": "publish",
            "http": {
              "identity": "finance",
              "method": "POST",
              "path": "/api/projects/{project_id}/process-report/publish",
              "project": "handoff",
              "json": {
                "note": "发布"
              }
            }
          },
          {
            "id": "confirm_cost",
            "http": {
              "identity": "director",
              "method": "POST",
              "path": "/api/projects/{project_id}/cost-review/confirm",
              "project": "handoff"
            }
          }
        ]
      },
      "actions": [],
      "expected": {
        "state": {
          "steps.publish.status": 403,
          "steps.publish.detail": {
            "$contains": "工艺技术总监"
          },
          "steps.confirm_cost.status": 403,
          "steps.confirm_cost.detail": {
            "$contains": "财务经理"
          }
        },
        "records": {
          "http_calls": 2
        },
        "forbidden": [
          "acl_blocked_professional_write",
          "acl_forbidden_message_leaked"
        ]
      },
      "invariants": [
        "single_source_of_truth"
      ],
      "tags": [
        "negative",
        "permission"
      ],
      "source_specs": [
        "docs/specs/tech-project-acl-visible-scope.md",
        "route:POST /api/projects/{project_id}/process-report/publish"
      ],
      "covers_routes": [
        "POST /api/projects/{project_id}/process-report/publish",
        "POST /api/projects/{project_id}/cost-review/confirm"
      ],
      "failure_type": "permission_denied",
      "notes": "双向反例：ACL 放行后，接口自己的角色门禁必须给出「这一步该谁做」的专属文案。"
    }
