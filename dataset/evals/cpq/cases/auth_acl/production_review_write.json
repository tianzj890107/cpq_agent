{
  "suite_id": "auth_acl.production_review_write",
  "title": "审核 / 发布专业写接口（真实路由 + 接口专属角色门禁）",
  "domain": "auth_acl",
  "cases": [
    {
      "id": "acl.real.director.publish_reaches_report_gate",
      "version": "1.0",
      "title": "工艺技术总监发布报告：通用写 ACL 不得提前阻断，落到报告自身的业务门禁",
      "domain": "auth_acl",
      "priority": "P1",
      "layer": "deterministic",
      "executor": "production_http",
      "entry": {
        "http": {
          "method": "POST",
          "path": "/api/projects/{project_id}/process-report/publish"
        }
      },
      "roles": [
        "reviewer"
      ],
      "preconditions": {},
      "input": {
        "access_matrix": {
          "frank": "allow",
          "heidi": "deny"
        },
        "identities": {
          "director": {
            "username": "frank",
            "display_name": "弗兰克",
            "sso_roles": [
              "process_director"
            ],
            "cpq_role_code": "tech_director",
            "tech_role": "process_director"
          },
          "manager": {
            "username": "carol",
            "display_name": "卡罗尔",
            "sso_roles": [
              "process_manager"
            ],
            "cpq_role_code": "process_mgr",
            "tech_role": "process_manager"
          }
        },
        "projects": {
          "handoff": {
            "owner": "carol",
            "filename": "handoff.dxf",
            "plan": {
              "finance_handoff": {
                "sent_at": "2026-09-17T10:00:00+08:00",
                "sent_by": "carol",
                "task_id": "T-COST-1",
                "task_no": "RW-1",
                "target_role_name": "财务经理",
                "target_type": "role"
              }
            },
            "participants": []
          }
        },
        "steps": [
          {
            "id": "publish",
            "http": {
              "identity": "director",
              "method": "POST",
              "path": "/api/projects/{project_id}/process-report/publish",
              "project": "handoff",
              "json": {
                "note": "发布"
              }
            }
          },
          {
            "id": "manager_publish",
            "http": {
              "identity": "manager",
              "method": "POST",
              "path": "/api/projects/{project_id}/process-report/publish",
              "project": "handoff",
              "json": {
                "note": "发布"
              }
            }
          }
        ]
      },
      "actions": [],
      "expected": {
        "state": {
          "steps.publish.status": 404,
          "steps.publish.detail": {
            "$ne": "项目不存在"
          },
          "steps.manager_publish.status": 404,
          "steps.manager_publish.detail": {
            "$ne": "项目不存在"
          }
        },
        "records": {
          "http_calls": 2
        },
        "forbidden": [
          "acl_blocked_professional_write",
          "acl_forbidden_message_leaked",
          "http_error_without_trace",
          "production_host_called",
          "real_secret_used"
        ]
      },
      "invariants": [],
      "tags": [
        "negative",
        "permission"
      ],
      "source_specs": [
        "docs/specs/tech-project-acl-visible-scope.md",
        "route:POST /api/projects/{project_id}/process-report/publish"
      ],
      "covers_routes": [
        "POST /api/projects/{project_id}/process-report/publish"
      ],
      "failure_type": "missing_prerequisite",
      "notes": "工艺经理在 CPQ 单经理模式下也拿到发布权，因此这里断言的是「进入业务门禁」，不是「被拒」。"
    },
