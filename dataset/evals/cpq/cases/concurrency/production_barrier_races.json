            "username": "dave",
            "display_name": "戴夫",
            "sso_roles": [
              "finance_manager"
            ],
            "cpq_role_code": "finance_mgr",
            "tech_role": "finance_manager"
          }
        },
        "steps": [
          {
            "id": "r1",
            "concurrent": {
              "threads": 2,
