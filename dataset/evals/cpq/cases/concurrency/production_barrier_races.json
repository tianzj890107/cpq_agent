      "version": "1.0",
      "title": "四个线程用 Barrier 同时加同一个财务参与者：真实 store 幂等，最终只有一行",
      "domain": "concurrency",
      "priority": "P0",
      "layer": "deterministic",
      "executor": "production_unit",
      "entry": {
        "module": "backend.storage.store",
        "function": "add_participant"
      },
      "roles": [
        "finance_mgr"
      ],
      "preconditions": {},
      "input": {
        "projects": {
          "handoff": {
            "owner": "carol",
            "filename": "handoff.dxf",
            "plan": {
              "finance_handoff": {
                "sent_at": "2026-09-17T10:00:00+08:00",
                "sent_by": "carol",
                "task_id": "T-COST-1",
                "target_role_name": "财务经理"
              }
            },
            "participants": []
          }
        },
        "identities": {
          "finance": {
            "username": "dave",
            "display_name": "戴夫",
            "sso_roles": [
              "finance_manager"
            ],
            "cpq_role_code": "finance_mgr",
            "tech_role": "finance_manager"
          }
        },
        "steps": [
          {
            "id": "race",
            "concurrent": {
              "threads": 4,
              "call": {
                "module": "backend.storage.store",
                "function": "add_participant",
                "args": {
                  "project_id": {
                    "$project_id": "handoff"
                  },
                  "username": "dave",
                  "role": "finance_manager",
                  "source": "cost_task_assignee",
                  "assignee": true
                }
              }
            }
          },
          {
            "id": "rows",
            "call": {
              "module": "backend.storage.store",
              "function": "list_participants",
              "args": {
                "project_id": {
                  "$project_id": "handoff"
                }
              }
            }
          }
        ]
      },
      "actions": [],
      "expected": {
        "state": {
          "steps.race.threads": 4,
          "steps.race.errors.0": {
            "$absent": true
          },
          "steps.rows.result": {
            "$len": 1
          }
        },
        "records": {
          "unit_calls": {
            "$gte": 5
          }
        },
        "forbidden": [
          "sim_fallback"
        ]
      },
      "invariants": [
        "no_duplicate_side_effect"
      ],
      "tags": [
        "concurrency",
        "duplicate"
      ],
      "source_specs": [
        "docs/specs/quote-task-coexistence-and-atomic-claim.md",
        "docs/specs/tech-handoff-atomic-idempotent-close.md",
        "module:backend.storage.store"
      ],
      "failure_type": "concurrency_conflict",
      "notes": "裁决权在真实 store 的幂等写入，不在测试线程里；测试只用 Barrier 让它们同时起跑。"
    },
    {
