{
  "suite_id": "concurrency.task.pool",
  "title": "任务池与状态机：原子领取、状态转换、重复完成、取消与完成竞争",
  "domain": "concurrency",
  "notes": "并发用例一律用 barrier + 线程 + 原子更新 / 唯一约束裁决；不使用 sleep，也不做串行 SELECT-INSERT 模拟。",
  "cases": [
    {
      "id": "conc.task.atomic_claim_two_workers",
      "version": "1.0",
      "title": "公共任务池：两人同时领取只有一个成功（barrier + 原子更新）",
      "domain": "concurrency",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "process_mgr",
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "ct1-send",
        "actors": {
          "carol2": {
            "roles": [
              "process_mgr"
            ]
          }
        }
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "ct1",
          "actor": "erin",
          "owner": "erin",
          "current_step": 1,
          "business_case_id": "bc_task0000001",
          "fields": {
            "customer": "亿纬锂能"
          }
        },
        {
          "op": "task_send",
          "session_id": "ct1",
          "actor": "erin",
          "task_kind": "tech_new_product",
          "target_type": "role",
          "target_role_code": "process_mgr",
          "payload": {
            "business_case_id": "bc_task0000001",
            "initiator": "erin"
          },
          "idempotency_key": "ct1-send"
        },
        {
          "op": "task_claim_concurrent",
          "task_id": "t_001",
          "actors": [
            "carol",
            "carol2"
          ]
        }
      ],
      "expected": {
        "http": {
          "code": "concurrent_claim_done",
          "threads": 2,
          "used_barrier": true,
          "arbiter": "atomic_update",
          "winners": {
            "$len": 1
          },
          "losers": {
            "$len": 1
          }
        },
        "concurrency": {
          "threads": 2,
          "used_barrier": true,
          "arbiter": "atomic_update",
          "winners": {
            "$len": 1
          },
          "losers": {
            "$len": 1
          }
        },
        "state": {
          "tasks.t_001.status": "claimed"
        },
        "records": {
          "tasks_claimed": 1
        },
        "forbidden": [
          "duplicate_side_effect",
          "timing_race_based"
        ]
      },
      "invariants": [
        "atomic_claim",
        "no_duplicate_side_effect"
      ],
      "tags": [
        "concurrency",
        "conflict"
      ],
      "source_specs": [
        "docs/specs/quote-task-coexistence-and-atomic-claim.md",
        "cpq_wf.py"
      ],
      "failure_type": "concurrency_conflict"
    },
