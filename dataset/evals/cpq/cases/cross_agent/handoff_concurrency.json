{
  "suite_id": "cross_agent.handoff.concurrency",
  "title": "跨 Agent 并发：回传 / 领取 / 取消与完成竞争 / 物料编码唯一约束",
  "domain": "cross_agent",
  "notes": "并发正确性由 barrier + 线程 + 原子更新 / 唯一约束裁决，不允许用 sleep 或串行 SELECT-INSERT 模拟。",
  "cases": [
    {
      "id": "cross.conc.handoff_concurrent_once",
      "version": "1.0",
      "title": "两次并发回传只有一次产生副作用（唯一约束裁决）",
      "domain": "cross_agent",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "finance_mgr",
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "cc-1"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qb1",
          "actor": "erin",
          "owner": "erin",
          "current_step": 2,
          "business_case_id": "bc_conc0000001",
          "fields": {
            "customer": "亿纬锂能"
          }
        },
        {
          "op": "task_send",
          "session_id": "qb1",
          "actor": "erin",
          "task_kind": "tech_cost",
          "target_type": "role",
          "target_role_code": "finance_mgr",
          "payload": {
            "business_case_id": "bc_conc0000001",
            "initiator": "erin"
          },
          "idempotency_key": "cc-1"
        },
        {
          "op": "task_claim",
          "task_id": "t_001",
          "actor": "dave"
        },
        {
          "op": "handoff_send_concurrent",
          "actors": [
            "dave",
            "dave"
          ],
          "source_project_id": "tp_conc1",
          "source_task_id": "t_001",
          "source_result_version": "R1",
          "handoff_kind": "cost",
          "business_case_id": "bc_conc0000001",
          "target_quote_session_id": "qb1",
          "target_role_code": "sales_mgr",
          "snapshot": {
            "cost": {
              "total": "11.0000"
            }
          }
        }
      ],
      "expected": {
        "http": {
          "code": "concurrent_handoff_done",
          "rows": 1,
          "threads": 2,
          "used_barrier": true,
          "arbiter": "unique_constraint"
        },
        "concurrency": {
          "threads": 2,
          "used_barrier": true,
          "arbiter": "unique_constraint",
          "rows": 1
        },
        "state": {
          "quote.qb1.current_step": 3,
          "tasks.t_001.status": "completed"
        },
        "records": {
          "handoff_rows": 1,
          "handoffs_created": 1,
          "handoff_replays": 1,
          "cards_created_by_handoff": 0
        },
        "forbidden": [
          "duplicate_side_effect",
          "timing_race_based",
          "silent_new_card"
        ]
      },
      "invariants": [
        "atomic_claim",
        "no_duplicate_side_effect"
      ],
      "tags": [
        "concurrency",
        "conflict",
        "idempotent"
      ],
      "source_specs": [
        "docs/specs/tech-handoff-atomic-idempotent-close.md",
        "docs/specs/tech-quote-business-case-linkage.md"
      ],
      "quote_step": 2,
      "failure_type": "concurrency_conflict"
    },
