{
  "suite_id": "cross_agent.handoff.flow",
  "title": "跨 Agent 闭环：找不到标品派发、领取、成本回传、复核、发布回传与销售续步",
  "domain": "cross_agent",
  "notes": "技术侧回传只合并快照并认回原报价卡片；卡片停在原步骤等待，历史回传不得让 current_step 倒退。",
  "cases": [
    {
      "id": "cross.flow.no_std_product_dispatch",
      "version": "1.0",
      "title": "报价第 1 步找不到标品：派发新增工艺任务，卡片留在原步骤",
      "domain": "cross_agent",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "sales_mgr",
        "process_mgr"
      ],
      "preconditions": {
        "card": "qa1 第 1 步匹配不到标品"
      },
      "input": {
        "idempotency_key": "cx-dispatch"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qa1",
          "actor": "erin",
          "owner": "erin",
          "current_step": 1,
          "business_case_id": "bc_cross000001",
          "fields": {
            "customer": "亿纬锂能"
          }
        },
        {
          "op": "quote_match_product",
          "session_id": "qa1",
          "actor": "erin",
          "params": [
            {
              "name": "电压",
              "matched": false
            },
            {
              "name": "容量",
              "matched": false
            }
          ]
        },
        {
          "op": "quote_send_tech_task",
          "session_id": "qa1",
          "actor": "erin",
          "target_role_code": "process_mgr",
          "note": "没有匹配标品，请新增工艺",
          "idempotency_key": "cx-dispatch"
        },
        {
          "op": "quote_snapshot",
          "session_id": "qa1",
          "actor": "erin"
        }
      ],
      "expected": {
        "http": {
          "current_step": 1,
          "business_case_id": "bc_cross000001"
        },
        "state": {
          "quote.qa1.current_step": 1,
          "quote.qa1.steps.1": {
            "$absent": true
          },
          "tasks.t_001.task_kind": "tech_new_product",
          "tasks.t_001.target_role_code": "process_mgr",
          "tasks.t_001.payload.business_case_id": "bc_cross000001",
          "tasks.t_001.status": "open"
        },
        "records": {
          "tasks_sent": 1,
          "cards": 1
        },
        "ui_protocol": {
          "monotonic_ui_stage": true
        },
        "forbidden": [
          "step_rollback",
          "cross_project_leak"
        ]
      },
      "invariants": [
        "step_monotonic",
        "no_cross_project_leak"
      ],
      "tags": [
        "normal",
        "cross-agent"
      ],
      "source_specs": [
        "docs/specs/tech-handoff-atomic-idempotent-close.md",
        "docs/specs/quote-task-coexistence-and-atomic-claim.md"
      ],
      "quote_step": 1
    },
