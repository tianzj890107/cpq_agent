      "version": "1.0",
      "title": "后端 400：请求体不合法时返回稳定错误码与 trace_id",
      "domain": "failure_recovery",
      "priority": "P1",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "fail.http.400_bad_request"
      },
      "actions": [
        {
          "op": "http_call",
          "route": "/api/quote/cards",
          "status": "400",
          "code": "bad_request"
        }
      ],
      "expected": {
        "http": {
          "status": 400,
          "ok": false,
          "code": "bad_request",
          "route": "/api/quote/cards",
          "trace_id": {
            "$present": true
          },
          "header_trace_id": {
            "$present": true
          }
        },
        "ui_protocol": {
          "error_code_with_trace": true
        },
        "forbidden": [
          "generic_error_body",
          "unsaved_on_failure"
        ]
      },
      "invariants": [
        "transaction_all_or_nothing"
      ],
      "tags": [
        "negative",
        "error"
      ],
      "source_specs": [
        "docs/specs/chat-errors-inflow-and-drop-refresh-task-cards.md",
        "cpq_wf.py"
      ],
      "failure_type": "invalid_output"
