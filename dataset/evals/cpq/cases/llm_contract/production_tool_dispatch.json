{
  "suite_id": "llm_contract.production_tool_dispatch",
  "title": "模型回放进入真实 Agent 工具分发边界",
  "domain": "llm_contract",
  "cases": [
    {
      "id": "llm.real.recorded_unknown_tool_is_rejected_by_dispatcher",
      "version": "1.0",
      "title": "回放的模型响应里出现未知工具：真实平台分发器用 fixture 里的工具名明确拒绝，不执行、不落库",
      "domain": "llm_contract",
      "priority": "P1",
      "layer": "recorded_provider",
      "executor": "recorded_provider",
      "entry": {
        "module": "backend.services.oc_agent",
        "function": "_run_platform_tool"
      },
      "roles": [
        "process_mgr"
      ],
      "preconditions": {},
      "input": {
        "projects": {
          "tech": {
            "owner": "alice",
            "filename": "a.dxf"
          }
        },
        "identities": {
          "director": {
            "username": "frank",
            "display_name": "弗兰克",
            "sso_roles": [
              "process_director"
            ],
            "cpq_role_code": "tech_director",
            "tech_role": "process_director"
          }
        },
        "steps": [
          {
            "id": "dispatch",
            "call": {
              "module": "backend.services.oc_agent",
              "function": "_run_platform_tool",
              "args": {
                "name": {
                  "$fixture": "provider/unknown_tool.json",
                  "$pick": "stream.0.name"
                },
                "params": {
                  "$fixture": "provider/unknown_tool.json",
                  "$pick": "stream.0.input"
                },
                "cwd": {
                  "$project_id": "tech"
                }
              }
            }
          }
        ],
        "provider": "provider/unknown_tool.json"
      },
      "actions": [],
      "expected": {
        "state": {
          "steps.dispatch.result": {
            "$contains_text": "未知的平台工具：shell_exec"
          },
          "steps.dispatch.tool": "_run_platform_tool",
          "steps.dispatch.module": "backend.services.oc_agent"
        },
        "records": {
          "unit_calls": 1
        },
        "forbidden": [
          "partial_write_on_failure",
          "sim_fallback",
          "production_host_called"
        ]
      },
      "invariants": [
        "no_duplicate_side_effect"
      ],
      "tags": [
        "negative",
        "provider"
      ],
      "source_specs": [
        "docs/specs/tech-agent-recovery-22-e2e-scenarios.json",
        "module:backend.services.oc_agent"
      ],
      "failure_type": "invalid_output",
      "notes": "fixture 的 stream[0] 就是 tool_use(shell_exec)；案例用 $fixture 把工具名与参数喂进真实 _run_platform_tool，断言真实拒绝文案（不是 Sim 状态）。"
    },
