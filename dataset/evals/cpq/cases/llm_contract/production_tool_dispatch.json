    {
      "id": "llm.real.truncation_recovery_uses_real_llm_output",
      "version": "1.0",
      "title": "截断响应恢复：真实 llm_output 判定 length 截断、提高预算并拼接续写片段",
      "domain": "llm_contract",
      "priority": "P1",
      "layer": "recorded_provider",
      "executor": "recorded_provider",
      "entry": {
        "module": "backend.services.llm_output",
        "function": "stitch_fragments"
      },
      "roles": [
        "process_mgr"
      ],
      "preconditions": {},
      "input": {
        "projects": {},
        "identities": {
          "director": {
            "username": "frank",
            "display_name": "弗兰克",
            "sso_roles": [
              "process_director"
            ],
            "cpq_role_code": "tech_director",
            "tech_role": "process_director"
          }
        },
        "steps": [
          {
            "id": "flag",
            "call": {
              "module": "backend.services.llm_output",
              "function": "is_truncated",
              "args": {
                "reason": {
                  "$fixture": "provider/truncated_recoverable.json",
                  "$pick": "finish_reason"
                }
              }
            }
          },
          {
            "id": "stitch",
            "call": {
              "module": "backend.services.llm_output",
              "function": "stitch_fragments",
              "args": {
                "partial": {
                  "$fixture": "provider/truncated_recoverable.json",
                  "$pick": "stream.0.input.values.焊接方式"
                },
                "addition": {
                  "$fixture": "provider/truncated_recoverable.json",
                  "$pick": "continuation.tool_use.input.values.焊接电流"
                }
              }
            }
          }
        ],
        "provider": "provider/truncated_recoverable.json"
      },
      "actions": [],
      "expected": {
        "state": {
          "steps.flag.result": true,
          "steps.stitch.result": "激光焊120A",
          "steps.stitch.tool": "stitch_fragments"
        },
        "records": {
          "unit_calls": 2
        },
        "forbidden": [
          "sim_fallback"
        ]
      },
      "invariants": [
        "no_duplicate_side_effect"
      ],
      "tags": [
        "recovery",
        "provider"
      ],
      "source_specs": [
        "docs/specs/tech-agent-recovery-22-e2e-scenarios.json",
        "module:backend.services.llm_output"
      ],
      "failure_type": "provider_error",
      "notes": "finish_reason 与续写片段都来自同一个 fixture，回放确实驱动了真实 llm_output 函数。"
    },
