{
  "suite_id": "quote.step3.margin",
  "title": "报价第 3 步：定价-利润加成（金额、边界、权限、重算）",
  "domain": "quote",
  "notes": "金额一律 decimal 字符串；边界值覆盖零值 / 超大值 / 4 位小数；权限与前置失败不得留下半写数据。",
  "cases": [
    {"id": "quote.step3.margin.basic", "version": "1.0", "title": "第 3 步利润加成：基础成本 + 技术加价 + 市场调整一次算清", "domain": "quote", "priority": "P0", "layer": "deterministic", "roles": ["sales_mgr"], "preconditions": {"card": "qs_m1 已到第 3 步"}, "input": {"idempotency_key": "s3-basic"}, "actions": [{"op": "create_quote_card", "session_id": "qs_m1", "actor": "erin", "owner": "erin", "current_step": 3, "fields": {"customer": "亿纬锂能"}}, {"op": "quote_complete_step", "session_id": "qs_m1", "step": 3, "actor": "erin", "snapshot": {"base_cost": "5.6000", "tech_premium": "1.5000", "market_adjust": "-0.2000"}, "idempotency_key": "s3-basic"}], "expected": {"http": {"code": "completed", "step": 3, "current_step": 4, "version": "v1"}, "state": {"quote.qs_m1.current_step": 4, "quote.qs_m1.current_owner": "sales_mgr", "quote.qs_m1.totals.profit_margin": "6.9000", "quote.qs_m1.totals.expected_price": "6.9000", "quote.qs_m1.totals.quote_price": "6.9000"}, "records": {"quote_steps_completed": 1, "quote_versions": 1}, "forbidden": ["float_money", "step_rollback"]}, "invariants": ["money_is_decimal", "step_monotonic"], "tags": ["normal", "money"], "source_specs": ["cpq_wf.py"], "quote_step": 3},
    {"id": "quote.step3.margin.rounding", "version": "1.0", "title": "金额保留 4 位小数：不出现浮点模糊比较", "domain": "quote", "priority": "P1", "layer": "deterministic", "roles": ["sales_mgr"], "preconditions": {}, "input": {"idempotency_key": "s3-round"}, "actions": [{"op": "create_quote_card", "session_id": "qs_m2", "actor": "erin", "owner": "erin", "current_step": 3, "fields": {"customer": "远景能源"}}, {"op": "quote_complete_step", "session_id": "qs_m2", "step": 3, "actor": "erin", "snapshot": {"base_cost": "1.23456", "tech_premium": "0.00004", "market_adjust": "0"}, "idempotency_key": "s3-round"}], "expected": {"http": {"code": "completed", "step": 3}, "state": {"quote.qs_m2.totals.profit_margin": "1.2346", "quote.qs_m2.totals.expected_price": "1.2346"}, "records": {"quote_steps_completed": 1}}, "invariants": ["money_is_decimal"], "tags": ["normal", "money", "boundary"], "source_specs": ["cpq_wf.py"], "quote_step": 3},
    {"id": "quote.step3.margin.zero", "version": "1.0", "title": "全零金额：仍写出 4 位小数的零值，不跳过计算", "domain": "quote", "priority": "P1", "layer": "deterministic", "roles": ["sales_mgr"], "preconditions": {}, "input": {"idempotency_key": "s3-zero"}, "actions": [{"op": "create_quote_card", "session_id": "qs_m3", "actor": "erin", "owner": "erin", "current_step": 3, "fields": {"customer": "国轩高科"}}, {"op": "quote_complete_step", "session_id": "qs_m3", "step": 3, "actor": "erin", "snapshot": {"base_cost": "0", "tech_premium": "0", "market_adjust": "0"}, "idempotency_key": "s3-zero"}], "expected": {"http": {"code": "completed", "step": 3}, "state": {"quote.qs_m3.totals.profit_margin": "0.0000", "quote.qs_m3.totals.quote_price": "0.0000"}, "records": {"quote_steps_completed": 1}}, "invariants": ["money_is_decimal"], "tags": ["normal", "money", "boundary"], "source_specs": ["cpq_wf.py"], "quote_step": 3},
    {"id": "quote.step3.margin.huge", "version": "1.0", "title": "超大金额：小数位不丢，仍然只前进不发散", "domain": "quote", "priority": "P1", "layer": "deterministic", "roles": ["sales_mgr"], "preconditions": {}, "input": {"idempotency_key": "s3-huge"}, "actions": [{"op": "create_quote_card", "session_id": "qs_m4", "actor": "erin", "owner": "erin", "current_step": 3, "fields": {"customer": "宁德时代"}}, {"op": "quote_complete_step", "session_id": "qs_m4", "step": 3, "actor": "erin", "snapshot": {"base_cost": "123456789.1234", "tech_premium": "0.0001", "market_adjust": "0"}, "idempotency_key": "s3-huge"}], "expected": {"http": {"code": "completed", "step": 3, "current_step": 4}, "state": {"quote.qs_m4.totals.profit_margin": "123456789.1235"}, "records": {"quote_steps_completed": 1}}, "invariants": ["money_is_decimal"], "tags": ["normal", "money", "boundary"], "source_specs": ["cpq_wf.py"], "quote_step": 3},
    {"id": "quote.step3.margin.role_denied", "version": "1.0", "title": "工艺经理不能替销售完成第 3 步（403）", "domain": "quote", "priority": "P0", "layer": "deterministic", "roles": ["process_mgr", "sales_mgr"], "preconditions": {}, "input": {"idempotency_key": "s3-deny"}, "actions": [{"op": "create_quote_card", "session_id": "qs_m5", "actor": "erin", "owner": "erin", "current_step": 3, "fields": {"customer": "亿纬锂能"}}, {"op": "quote_complete_step", "session_id": "qs_m5", "step": 3, "actor": "carol", "snapshot": {"base_cost": "5.6000"}, "idempotency_key": "s3-deny", "expect": {"status": 403, "code": "step_role_forbidden"}}], "expected": {"http": {"status": 403, "code": "step_role_forbidden"}, "state": {"quote.qs_m5.current_step": 3, "quote.qs_m5.steps.3": {"$absent": true}}, "records": {"quote_steps_completed": 0}, "forbidden": ["denied_actor_allowed", "step_rollback"]}, "invariants": ["step_monotonic"], "tags": ["negative", "deny", "permission"], "source_specs": ["cpq_wf.py"], "quote_step": 3, "failure_type": "permission_denied"},
    {"id": "quote.step3.margin.prereq_missing", "version": "1.0", "title": "第 2 步没完成时不能跳到第 3 步（409）", "domain": "quote", "priority": "P0", "layer": "deterministic", "roles": ["sales_mgr"], "preconditions": {}, "input": {"idempotency_key": "s3-skip"}, "actions": [{"op": "create_quote_card", "session_id": "qs_m6", "actor": "erin", "owner": "erin", "current_step": 2, "fields": {"customer": "亿纬锂能"}}, {"op": "quote_complete_step", "session_id": "qs_m6", "step": 3, "actor": "erin", "snapshot": {"base_cost": "5.6000"}, "idempotency_key": "s3-skip", "expect": {"status": 409, "code": "step_not_ready"}}], "expected": {"http": {"status": 409, "code": "step_not_ready"}, "state": {"quote.qs_m6.current_step": 2, "quote.qs_m6.totals.profit_margin": {"$absent": true}}, "records": {"quote_steps_completed": 0}, "forbidden": ["step_rollback"]}, "invariants": ["step_monotonic"], "tags": ["negative", "prerequisite"], "source_specs": ["cpq_wf.py"], "quote_step": 3, "failure_type": "missing_prerequisite"},
    {"id": "quote.step3.margin.repeat_idempotent", "version": "1.0", "title": "同一幂等键重复提交：不产生第二个报价版本", "domain": "quote", "priority": "P0", "layer": "deterministic", "roles": ["sales_mgr"], "preconditions": {}, "input": {"idempotency_key": "s3-rep"}, "actions": [{"op": "create_quote_card", "session_id": "qs_m7", "actor": "erin", "owner": "erin", "current_step": 3, "fields": {"customer": "亿纬锂能"}}, {"op": "quote_complete_step", "session_id": "qs_m7", "step": 3, "actor": "erin", "snapshot": {"base_cost": "5.6000"}, "idempotency_key": "s3-rep", "expect": {"code": "completed"}}, {"op": "quote_complete_step", "session_id": "qs_m7", "step": 3, "actor": "erin", "snapshot": {"base_cost": "5.6000"}, "idempotency_key": "s3-rep", "expect": {"code": "already_completed", "idempotent": true, "version": "v1"}}], "expected": {"http": {"code": "already_completed", "idempotent": true, "version": "v1", "step": 3}, "state": {"quote.qs_m7.current_step": 4}, "records": {"quote_versions": 1, "quote_steps_completed": 1}, "forbidden": ["duplicate_side_effect", "step_rollback"]}, "invariants": ["no_duplicate_side_effect"], "tags": ["idempotent", "duplicate"], "source_specs": ["cpq_wf.py"], "quote_step": 3, "failure_type": "duplicate_request"}
  ]
}
