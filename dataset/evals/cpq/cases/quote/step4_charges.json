      "id": "quote.step4.charges.retry_idempotent",
      "version": "1.0",
      "title": "临时故障后重放：同一幂等键不重复写快照 / 消息",
      "domain": "quote",
      "priority": "P1",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
