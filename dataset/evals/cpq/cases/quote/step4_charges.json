{
  "suite_id": "quote.step4.charges",
  "title": "报价第 4 步：报价-其他加价项（重复项、负值、非法金额、重试）",
  "domain": "quote",
  "notes": "加价项重复 / 负值 / 非 decimal 都必须被拒且整体回滚；重试复用幂等键不重复写。",
  "cases": [
    {
      "id": "quote.step4.charges.multi",
      "version": "1.0",
      "title": "第 4 步其他加价项：多类加价并入预期价",
      "domain": "quote",
      "priority": "P1",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "s4-multi"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_c1",
          "actor": "erin",
          "owner": "erin",
          "current_step": 4,
          "fields": {
            "customer": "亿纬锂能"
          },
          "totals": {
            "base_cost": "2.0000"
          }
        },
        {
          "op": "quote_complete_step",
          "session_id": "qs_c1",
          "step": 4,
          "actor": "erin",
          "snapshot": {
            "charges": [
              {
                "name": "运费",
                "amount": "0.8000"
              },
              {
                "name": "包装",
                "amount": "0.2000"
              }
            ]
          },
          "idempotency_key": "s4-multi"
        }
      ],
      "expected": {
        "http": {
          "code": "completed",
          "step": 4,
          "current_step": 5
        },
        "state": {
          "quote.qs_c1.totals.extra_charges": "1.0000",
          "quote.qs_c1.totals.expected_price": "3.0000",
          "quote.qs_c1.totals.quote_price": "3.0000",
          "quote.qs_c1.totals.charges": {
            "$len": 2
          }
        },
        "records": {
          "quote_steps_completed": 1
        },
        "forbidden": [
          "float_money",
          "duplicate_side_effect"
        ]
      },
      "invariants": [
        "money_is_decimal"
      ],
      "tags": [
        "normal",
        "money"
      ],
      "source_specs": [
        "cpq_wf.py"
      ],
      "quote_step": 4
    },
    {
      "id": "quote.step4.charges.duplicate_rejected",
      "version": "1.0",
      "title": "同名加价项重复提交必须被拒（409 duplicate_charge）",
      "domain": "quote",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "s4-dup"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_c2",
          "actor": "erin",
          "owner": "erin",
          "current_step": 4,
          "fields": {
            "customer": "亿纬锂能"
          },
          "totals": {
            "base_cost": "2.0000"
          }
        },
        {
          "op": "quote_complete_step",
          "session_id": "qs_c2",
          "step": 4,
          "actor": "erin",
          "snapshot": {
            "charges": [
              {
                "name": "运费",
                "amount": "0.8000"
              },
              {
                "name": "运费",
                "amount": "0.3000"
              }
            ]
          },
          "idempotency_key": "s4-dup",
          "expect": {
            "status": 409,
            "code": "duplicate_charge"
          }
        }
      ],
      "expected": {
        "http": {
          "status": 409,
          "code": "duplicate_charge"
        },
        "state": {
          "quote.qs_c2.current_step": 4,
          "quote.qs_c2.steps.4": {
            "$absent": true
          },
          "quote.qs_c2.totals.extra_charges": {
            "$absent": true
          }
        },
        "records": {
          "quote_steps_completed": 0
        },
        "forbidden": [
          "duplicate_side_effect",
          "step_rollback"
        ]
      },
      "invariants": [
        "no_duplicate_side_effect",
        "transaction_all_or_nothing"
      ],
      "tags": [
        "negative",
        "duplicate"
      ],
      "source_specs": [
        "cpq_wf.py"
      ],
      "quote_step": 4,
      "failure_type": "duplicate_request"
    },
