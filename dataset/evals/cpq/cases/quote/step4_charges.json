            "customer": "亿纬锂能"
          },
          "totals": {
            "base_cost": "2.0000"
          }
        },
        {
          "op": "retry_action",
          "target_op": "quote_complete_step",
          "session_id": "qs_c7",
          "step": 4,
          "actor": "erin",
          "snapshot": {
            "charges": [
              {
                "name": "运费",
                "amount": "0.8000"
              }
            ]
          },
          "idempotency_key": "s4-retry",
          "expect": {
            "code": "retry_done",
            "attempts": 3,
            "no_duplicate": true
          }
        }
      ],
