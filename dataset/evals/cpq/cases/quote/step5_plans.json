      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "s5-idem"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_p3",
          "actor": "erin",
          "owner": "erin",
          "current_step": 5,
