          "idempotency_key": "s5-gen3"
        },
        {
          "op": "quote_select_plan",
          "session_id": "qs_p3",
          "actor": "erin",
          "plan_id": "p1",
          "expect": {
            "code": "OK"
          }
        },
        {
          "op": "quote_select_plan",
          "session_id": "qs_p3",
          "actor": "erin",
          "plan_id": "p1",
          "expect": {
            "code": "already_selected"
          }
        }
      ],
      "expected": {
        "http": {
          "code": "already_selected",
          "plan_id": "p1"
        },
        "state": {
          "quote.qs_p3.selected_plan": "p1",
          "quote.qs_p3.totals.quote_price": "1.9000"
        },
        "records": {
          "plans": 1
        },
        "forbidden": [
          "duplicate_side_effect"
        ]
      },
      "invariants": [
        "no_duplicate_side_effect"
      ],
      "tags": [
