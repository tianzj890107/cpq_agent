{
  "suite_id": "quote.step.guard",
  "title": "报价跨步骤守护：回改重算、单调前进、历史回传只合并快照",
  "domain": "quote",
  "notes": "修改已完成步骤必须让下游 stale 并重算，但 current_step 与页面 stage 只能前进。",
  "cases": [
    {
      "id": "quote.guard.edit_step_recompute",
      "version": "1.0",
      "title": "回改已完成步骤：下游标 stale、重新计算、current_step 不倒退",
      "domain": "quote",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "sG-edit"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_g1",
          "actor": "erin",
          "owner": "erin",
          "current_step": 5,
          "fields": {
            "customer": "亿纬锂能"
          },
          "totals": {
            "base_cost": "5.6000"
          }
        },
        {
          "op": "quote_edit_step",
          "session_id": "qs_g1",
          "step": 3,
          "actor": "erin",
          "snapshot": {
            "base_cost": "9.0000"
          },
          "idempotency_key": "sG-edit"
        }
      ],
      "expected": {
        "http": {
          "code": "recomputed",
          "current_step": 5,
          "stale_steps": [
            4
          ]
        },
        "state": {
          "quote.qs_g1.current_step": 5,
          "quote.qs_g1.steps.4.stale": true,
          "quote.qs_g1.totals.profit_margin": "9.0000"
        },
        "records": {
          "quote_recomputes": 1
        },
        "ui_protocol": {
          "monotonic_ui_stage": true
        },
        "forbidden": [
          "step_rollback",
          "stale_written_as_fresh"
        ]
      },
      "invariants": [
        "step_monotonic"
      ],
      "tags": [
        "recovery",
        "stale"
      ],
      "source_specs": [
        "cpq_wf.py"
      ],
      "quote_step": 3,
      "failure_type": "stale_upstream"
    },
    {
      "id": "quote.guard.edit_step_role_denied",
      "version": "1.0",
      "title": "非本步角色不能回改已完成步骤（403）",
      "domain": "quote",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "process_mgr",
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "sG-deny"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_g2",
          "actor": "erin",
          "owner": "erin",
          "current_step": 5,
          "fields": {
            "customer": "亿纬锂能"
          },
          "totals": {
            "base_cost": "5.6000"
          }
        },
        {
          "op": "quote_edit_step",
          "session_id": "qs_g2",
          "step": 3,
          "actor": "carol",
          "snapshot": {
            "base_cost": "9.0000"
          },
          "idempotency_key": "sG-deny",
          "expect": {
            "status": 403,
            "code": "step_role_forbidden"
          }
        }
      ],
      "expected": {
        "http": {
          "status": 403,
          "code": "step_role_forbidden"
        },
        "state": {
          "quote.qs_g2.totals.base_cost": "5.6000",
          "quote.qs_g2.current_step": 5
        },
        "records": {
          "quote_recomputes": 0
        },
        "forbidden": [
          "denied_actor_allowed",
          "step_rollback"
        ]
      },
      "invariants": [
        "step_monotonic"
      ],
      "tags": [
        "negative",
        "deny",
        "permission"
      ],
      "source_specs": [
        "cpq_wf.py"
      ],
      "quote_step": 3,
      "failure_type": "permission_denied"
    },
    {
      "id": "quote.guard.edit_step_not_completed",
      "version": "1.0",
      "title": "不能回改还没完成的步骤（409 step_not_completed）",
      "domain": "quote",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "sG-late"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_g3",
          "actor": "erin",
          "owner": "erin",
          "current_step": 3,
          "fields": {
            "customer": "亿纬锂能"
          },
          "totals": {
            "base_cost": "5.6000"
          }
        },
        {
          "op": "quote_edit_step",
          "session_id": "qs_g3",
          "step": 4,
          "actor": "erin",
          "snapshot": {
            "charges": [
              {
                "name": "运费",
                "amount": "0.8000"
              }
            ]
          },
          "idempotency_key": "sG-late",
          "expect": {
            "status": 409,
            "code": "step_not_completed"
          }
        }
      ],
      "expected": {
        "http": {
          "status": 409,
          "code": "step_not_completed"
        },
        "state": {
          "quote.qs_g3.current_step": 3,
          "quote.qs_g3.totals.charges": {
            "$absent": true
          }
        },
        "records": {
          "quote_recomputes": 0
        },
        "forbidden": [
          "step_rollback",
          "unsaved_on_failure"
        ]
      },
      "invariants": [
        "step_monotonic",
        "transaction_all_or_nothing"
      ],
      "tags": [
        "negative",
        "prerequisite"
      ],
      "source_specs": [
        "cpq_wf.py"
      ],
      "quote_step": 4,
      "failure_type": "missing_prerequisite"
    },
    {
      "id": "quote.guard.monotonic_after_late_handback",
      "version": "1.0",
      "title": "第 6 步收到历史技术回传：只合并快照，页面 stage 不回退",
      "domain": "quote",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "sales_mgr",
        "finance_mgr"
      ],
      "preconditions": {},
      "input": {
        "session_id": "qs_g4"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_g4",
          "actor": "erin",
          "owner": "erin",
          "current_step": 6,
          "business_case_id": "bc_guard00000g",
          "totals": {
            "base_cost": "5.6000"
          }
        },
        {
          "op": "task_send",
          "session_id": "qs_g4",
          "actor": "erin",
          "task_kind": "tech_cost",
          "target_type": "role",
          "target_role_code": "finance_mgr",
          "payload": {
            "business_case_id": "bc_guard00000g",
            "initiator": "erin"
          },
          "idempotency_key": "sG-cost"
        },
        {
          "op": "task_claim",
          "task_id": "t_001",
          "actor": "dave"
        },
        {
          "op": "handoff_send",
          "actor": "dave",
          "source_project_id": "tp_guard4",
          "source_task_id": "t_001",
          "source_result_version": "R1",
          "handoff_kind": "cost",
          "business_case_id": "bc_guard00000g",
          "target_quote_session_id": "qs_g4",
          "target_role_code": "sales_mgr",
          "snapshot": {
            "cost": {
              "total": "7.7000"
            }
          },
          "idempotency_key": "sG-hb",
          "expect": {
            "code": "sent",
            "current_step": 6
          }
        }
      ],
      "expected": {
        "http": {
          "code": "sent",
          "current_step": 6,
          "business_case_id": "bc_guard00000g",
          "source_task_id": "t_001",
          "source_project_id": "tp_guard4"
        },
        "state": {
          "quote.qs_g4.current_step": 6,
          "quote.qs_g4.steps.2.snapshot.cost.total": "7.7000"
        },
        "records": {
          "handoff_rows": 1,
          "cards_created_by_handoff": 0
        },
        "ui_protocol": {
          "monotonic_ui_stage": true
        },
        "forbidden": [
          "step_rollback",
          "silent_new_card"
        ]
      },
      "invariants": [
        "step_monotonic",
        "no_cross_project_leak"
      ],
      "tags": [
        "recovery",
        "stale",
        "cross-agent"
      ],
      "source_specs": [
        "cpq_wf.py",
        "docs/specs/tech-handoff-atomic-idempotent-close.md"
      ],
      "quote_step": 6,
      "failure_type": "stale_upstream"
    },
    {
      "id": "quote.guard.snapshot_versions",
      "version": "1.0",
      "title": "报价快照读数与完成步骤一致（版本数 / 当前步骤 / 业务实例号）",
      "domain": "quote",
      "priority": "P0",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "sG-snap"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_g5",
          "actor": "erin",
          "owner": "erin",
          "current_step": 5,
          "business_case_id": "bc_guard00000h",
          "fields": {
            "customer": "亿纬锂能"
          },
          "totals": {
