          }
        },
        {
          "op": "quote_complete_step",
          "session_id": "qs_g5",
          "step": 5,
          "actor": "erin",
          "snapshot": {
            "selected_plan": "p1"
          },
          "idempotency_key": "sG-snap"
        },
        {
          "op": "quote_snapshot",
          "session_id": "qs_g5",
          "actor": "erin"
        }
      ],
      "expected": {
        "http": {
          "current_step": 6,
          "versions": 1,
          "business_case_id": "bc_guard00000h",
