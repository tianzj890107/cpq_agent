        },
        "forbidden": [
          "step_rollback"
        ]
      },
      "invariants": [
        "step_monotonic"
      ],
      "tags": [
        "normal",
        "snapshot"
      ],
      "source_specs": [
        "cpq_wf.py"
      ],
      "quote_step": 5
    }
  ]
}
