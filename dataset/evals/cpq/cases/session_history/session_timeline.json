{
  "suite_id": "session_history.session_timeline",
  "title": "会话、历史与恢复：消息保存、顺序恢复、旧口径兼容、中断恢复与重放去重",
  "domain": "session_history",
  "notes": "历史消息原文与旧 page_context 原样保留；新显示统一五阶段口径。",
  "cases": [
    {
      "id": "hist.timeline.messages_persisted",
      "version": "1.0",
      "title": "Agent 消息完整保存：用户与助手消息按追加顺序落库",
      "domain": "session_history",
      "priority": "P1",
      "layer": "deterministic",
      "roles": [
        "process_engineer"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "hist-m1"
      },
      "actions": [
        {
          "op": "load_fixture_state",
          "fixture": "history/session_timeline_sample.json"
        },
        {
          "op": "session_append_event",
          "project_id": "tp_timeline",
          "actor": "alice",
          "kind": "message",
          "role": "user",
          "text": "补充：按 120A 复核",
          "dedup_key": "hist-m1"
        },
        {
          "op": "session_append_event",
          "project_id": "tp_timeline",
          "actor": "alice",
          "kind": "message",
          "role": "assistant",
          "text": "已按 120A 重新推荐参数",
          "dedup_key": "hist-m2"
        },
        {
          "op": "tech_timeline_read",
          "project_id": "tp_timeline",
          "actor": "alice"
        }
      ],
      "expected": {
        "http": {
          "status": 200,
          "code": "OK",
          "count": 7
        },
        "state": {
          "tech.tp_timeline.timeline.0.kind": "message",
          "tech.tp_timeline.timeline.0.text": "上传图纸并解析",
          "tech.tp_timeline.timeline.5.text": "补充：按 120A 复核",
          "tech.tp_timeline.timeline.6.kind": "message",
          "tech.tp_timeline.timeline.6.role": "assistant",
          "tech.tp_timeline.timeline.6.at": {
            "$format": "iso8601"
          }
        },
        "records": {
          "session_events": 2,
          "fixture_loads": 1
        },
        "forbidden": [
          "duplicate_side_effect"
        ]
      },
      "invariants": [
        "single_source_of_truth"
      ],
      "tags": [
        "normal",
        "history"
      ],
      "source_specs": [
        "docs/specs/tech-session-timeline-persistence-and-order.md"
      ]
    },
