{
  "suite_id": "ui_protocol.ui_protocol",
  "title": "UI 协议：左右同步、看板内展开、参数页签归属、错误面、主色、输入区对齐",
  "domain": "ui_protocol",
  "notes": "只断言有业务意义的协议项，不校验无业务意义的 CSS 细节。",
  "cases": [
    {
      "id": "ui.board.parse_fills_left_and_right",
      "version": "1.0",
      "title": "一键解析：左侧 Agent 输出与右侧看板同步填充，字段带来源徽标",
      "domain": "ui_protocol",
      "priority": "P2",
      "layer": "deterministic",
      "roles": [
        "sales_mgr"
      ],
      "preconditions": {},
      "input": {
        "idempotency_key": "ui-parse-1"
      },
      "actions": [
        {
          "op": "create_quote_card",
          "session_id": "qs_ui1",
          "actor": "erin",
          "owner": "erin",
          "current_step": 1
        },
        {
          "op": "quote_parse_requirement",
          "session_id": "qs_ui1",
          "actor": "erin",
          "document": "documents/requirement_ev_full.json",
          "idempotency_key": "ui-parse-1"
        },
        {
          "op": "ui_board_sync",
          "session_id": "qs_ui1"
        }
      ],
      "expected": {
        "http": {
          "status": 200,
          "code": "board_synced",
          "sources": [
            "ai_recommended"
          ]
        },
        "state": {
          "quote.qs_ui1.fields.customer.source": "ai_recommended",
          "quote.qs_ui1.fields.customer.value": "亿纬锂能",
          "quote.qs_ui1.left_summary.missing": {
            "$len": 0
          }
        },
        "ui_protocol": {
          "board_left_right_sync": true,
          "field_source_badge": [
            "ai_recommended"
          ],
          "monotonic_ui_stage": true
        },
        "forbidden": [
          "cross_project_leak"
        ]
      },
      "invariants": [
        "left_right_consistent"
      ],
      "tags": [
        "normal",
        "ui"
      ],
      "source_specs": [
        "cpq_wf.py"
      ]
    },
    {
      "id": "ui.board.manual_edit_changes_source_badge",
